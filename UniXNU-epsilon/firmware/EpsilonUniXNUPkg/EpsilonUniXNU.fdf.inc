## @file
#  FDF hooks: UniXNU + DarwinBoot + FV-embedded payload for Surface Duo 1 (epsilon).
#
#  Included as the LAST statement of [FV.FvMain] in
#  Platforms/SurfaceDuo1Pkg/SurfaceDuo1.fdf (after LinuxLoader.inf), so every file
#  lands in the LZMA-compressed inner volume. Nothing is added to FVMAIN_COMPACT
#  directly, and [FD.SM8150_EFI] (base 0x9FC01000, size 0x2EF000) is not changed.
#
#  Not in APRIORI: the drivers dispatch on their own depex after the stock
#  platform drivers; the two applications (UniXNU, EpsilonDiag) are never
#  dispatched, only loaded on request.
#
#  Storage stack the payload volume relies on, all already in the stock FD:
#    DiskIoDxe   (Qualcomm binary, APRIORI.inc)
#    Fat.inf     (FatPkg, SurfaceDuo1.fdf)
#    EnglishDxe  (Unicode collation, SurfaceDuo1.fdf)
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

  INF UniXNUPkg/Application/UniXNU/UniXNU.inf

!if $(UNIXNU_BOOT_OPTION) == 1
  INF UniXNUPkg/Driver/UniXNUDxe/UniXNUDxe.inf
!endif

  INF DarwinBootPkg/Driver/DarwinBoot.inf
  INF EpsilonUniXNUPkg/Driver/EpsilonPayloadDxe/EpsilonPayloadDxe.inf

  # T5 read-only diagnostic, started by UniXNU as fv:E59FE912-1804-4BB0-B27E-DAE17C9A703A.
  INF EpsilonUniXNUPkg/Application/EpsilonDiag/EpsilonDiag.inf

!if $(UNIXNU_FV_PAYLOAD) == 1
  # Payload FAT image (EFI/UniXNU/unixnu.toml only; the diagnostic is the FV
  # application above, not a file in this image). The GUID is
  # gEpsilonPayloadFileGuid in EpsilonUniXNUPkg.dec. Generated by
  # ../scripts/make-fv-payload.sh; never committed (*.fat is build output).
  FILE FREEFORM = F98C36DD-FAF0-4DC4-BFDB-A98F136DB804 {
    SECTION UI = "UniXNUPayload"
    SECTION RAW = EpsilonUniXNUPkg/Payload/payload.fat
  }
!endif
